{
  "name": "paperlight-reader",
  "version": "0.1.0",
  "private": true,
  "description": "极简 PDF / OFD 阅读器",
  "author": "9600bits",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build && npm run build:electron",
    "dist": "npm run build && electron-builder --win portable",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "postinstall": "node scripts/patch-ofdjs.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@sharp9/ofdjs": "^0.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.511.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wait-on": "^9.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "cn.paperlight.reader",
    "productName": "Paperlight 阅读器",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
